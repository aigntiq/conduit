{
    "name": "aigntiq-conduit-monorepo",
    "version": "0.1.0",
    "private": true,
    "description": "Declarative, pluggable connectors — describe an API once, call it from any host",
    "type": "module",
    "scripts": {
        "wt": "node scripts/worktree.mjs",
        "branch-protection": "node scripts/apply-branch-protection.mjs",
        "sync:core": "node scripts/sync-core.mjs",
        "verify:catalog": "node scripts/check-catalog.mjs",
        "verify:names": "node scripts/check-names.mjs",
        "gen:schema": "node scripts/gen-schema.mjs",
        "build": "pnpm -r --filter ./packages/* run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsgo --noEmit",
        "lint": "oxlint packages/conduit/src packages/conduit-connectors/src packages/conduit-connectors/connectors packages/conduit-connectors/scripts examples",
        "lint:fix": "oxlint --fix packages/conduit/src packages/conduit-connectors/src packages/conduit-connectors/connectors packages/conduit-connectors/scripts examples",
        "clean": "node -e \"for (const d of ['packages/conduit/dist', 'packages/conduit-connectors/dist']) require('fs').rmSync(d, { recursive: true, force: true })\"",
        "publish:dry": "node scripts/publish.js --dry-run",
        "publish:all": "node scripts/publish.js",
        "publish:beta": "node scripts/publish.js --tag beta",
        "version:set": "node scripts/bump-version.js",
        "version:patch": "node scripts/bump-version.js patch",
        "version:minor": "node scripts/bump-version.js minor",
        "version:major": "node scripts/bump-version.js major",
        "verify:pack": "node scripts/verify-pack.js",
        "size": "size-limit"
    },
    "devDependencies": {
        "@size-limit/preset-small-lib": "^11",
        "@types/node": "^26.6.1",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@vitest/coverage-v8": "^4.1.5",
        "oxlint": "^1.83.0",
        "size-limit": "^11",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vitest": "^4.1.5"
    },
    "keywords": [
        "aigntiq",
        "aigntiq",
        "conduit",
        "connectors",
        "integrations",
        "oauth"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aigntiq/conduit.git"
    },
    "homepage": "https://github.com/aigntiq/conduit#readme",
    "bugs": {
        "url": "https://github.com/aigntiq/conduit/issues"
    },
    "packageManager": "pnpm@10.33.4",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
