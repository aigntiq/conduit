{
    "spec": "conduit/1",
    "id": "google-sheets",
    "name": "Google Sheets",
    "version": "1.0.0",
    "description": "Read, append, update and clear rows in Google Sheets, and create spreadsheets and sheets.",
    "categories": [
        "spreadsheets",
        "productivity"
    ],
    "brandColor": "#188038",
    "homepage": "https://sheets.google.com",
    "helpUrl": "https://developers.google.com/sheets/api",
    "config": {
        "baseUrl": "https://sheets.googleapis.com/v4",
        "driveUrl": "https://www.googleapis.com/drive/v3"
    },
    "functions": {
        "quote": {
            "params": [
                "s"
            ],
            "description": "A Drive query string literal: single-quoted, with quotes and backslashes escaped.",
            "body": "\"'\" + replace(replace(string(s), \"\\\\\", \"\\\\\\\\\"), \"'\", \"\\\\'\") + \"'\""
        },
        "a1": {
            "params": [
                "sheet",
                "range"
            ],
            "description": "An A1 range on a sheet, the sheet name quoted: 'Q1 ''24'!A2:C.",
            "body": "\"'\" + replace(string(sheet), \"'\", \"''\") + \"'\" + (isEmpty(range) ? '' : '!' + range)"
        },
        "recordOf": {
            "params": [
                "headers",
                "row"
            ],
            "description": "A row as an object keyed by the header row.",
            "body": "fromEntries(map(headers, (h, i) => [h, default(row[i], \"\")]))"
        },
        "rowOf": {
            "params": [
                "headers",
                "row"
            ],
            "description": "A row to write: a list as it is, or an object put in header order.",
            "body": "type(row) == 'array' ? row : map(headers, h => default(row[h], ''))"
        }
    },
    "http": {
        "baseUrl": "{{config.baseUrl}}",
        "headers": {
            "Accept": "application/json"
        },
        "retry": {
            "attempts": 3,
            "initialDelayMs": 500,
            "maxDelayMs": 20000
        },
        "allowHosts": [
            "www.googleapis.com"
        ]
    },
    "auth": [
        {
            "id": "oauth",
            "type": "oauth2",
            "label": "Sign in with Google",
            "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
            "tokenUrl": "https://oauth2.googleapis.com/token",
            "revokeUrl": "https://oauth2.googleapis.com/revoke",
            "scopes": [
                "https://www.googleapis.com/auth/spreadsheets",
                "https://www.googleapis.com/auth/drive.metadata.readonly"
            ],
            "authorizeParams": {
                "access_type": "offline",
                "prompt": "consent",
                "include_granted_scopes": "true"
            },
            "identity": {
                "request": {
                    "url": "{{config.driveUrl}}/about",
                    "query": {
                        "fields": "user"
                    }
                },
                "id": "{{response.body.user.emailAddress}}",
                "name": "{{default(response.body.user.displayName, response.body.user.emailAddress)}}"
            },
            "test": {
                "url": "{{config.driveUrl}}/about",
                "query": {
                    "fields": "user"
                }
            },
            "helpUrl": "https://developers.google.com/sheets/api/scopes",
            "setup": "1. In the Google Cloud console, create (or pick) a project and **enable the Google Sheets API and the Google Drive API**.\n2. Configure the **OAuth consent screen** and add the scopes `https://www.googleapis.com/auth/spreadsheets`, `https://www.googleapis.com/auth/drive.metadata.readonly`.\n3. Create an **OAuth client ID** of type *Web application*. Add your Conduit callback URL (for example `https://app.example/conduit/auth/callback`) as an **authorized redirect URI**.\n4. Give the client id and secret to Conduit: `createConduit({ clients: { 'google-sheets': { id, secret } } })`.\n\nThe Drive API lists spreadsheets for the pickers; `drive.metadata.readonly` sees names only, never contents."
        }
    ],
    "operations": [
        {
            "id": "list-spreadsheets",
            "kind": "options",
            "label": "Spreadsheets",
            "readOnly": true,
            "inputs": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "title": "Search"
                    }
                }
            },
            "output": "{{map(default(response.body.files, []), f => {label: f.name, value: f.id})}}",
            "request": {
                "query": {
                    "q": "{{\"mimeType = 'application/vnd.google-apps.spreadsheet' and trashed = false\" + (isEmpty(inputs.query) ? '' : ' and name contains ' + quote(inputs.query))}}",
                    "fields": "files(id,name)",
                    "orderBy": "modifiedTime desc",
                    "pageSize": 100,
                    "includeItemsFromAllDrives": true,
                    "supportsAllDrives": true
                },
                "url": "{{config.driveUrl}}/files"
            }
        },
        {
            "id": "list-sheets",
            "kind": "options",
            "label": "Sheets",
            "readOnly": true,
            "inputs": {
                "type": "object",
                "properties": {
                    "spreadsheetId": {
                        "type": "string",
                        "title": "Spreadsheet"
                    }
                },
                "required": [
                    "spreadsheetId"
                ]
            },
            "errors": [
                {
                    "when": "{{response.status == 404}}",
                    "error": "notFound",
                    "message": "That spreadsheet does not exist, or is not shared with this account",
                    "field": "spreadsheetId"
                }
            ],
            "output": "{{default(response.body.sheets, []) | sortBy('properties.index') | map(s => {label: s.properties.title, value: s.properties.title})}}",
            "request": {
                "query": {
                    "fields": "sheets.properties(title,index)"
                },
                "url": "/spreadsheets/{{urlEncode(inputs.spreadsheetId)}}"
            }
        },
        {
            "id": "get-spreadsheet",
            "kind": "action",
            "label": "Get spreadsheet",
            "description": "Title, locale, time zone and the sheets with their sizes.",
            "group": "Spreadsheets",
            "readOnly": true,
            "inputs": {
                "type": "object",
                "properties": {
                    "spreadsheetId": {
                        "type": "string",
                        "title": "Spreadsheet",
                        "x-options": {
                            "operation": "list-spreadsheets",
                            "search": "query"
                        }
                    }
                },
                "required": [
                    "spreadsheetId"
                ]
            },
            "outputs": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string"
                    },
                    "locale": {
                        "type": "string"
                    },
                    "timeZone": {
                        "type": "string"
                    },
                    "sheets": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "sheetId": {
                                    "type": "integer"
                                },
                                "title": {
                                    "type": "string"
                                },
                                "index": {
                                    "type": "integer"
                                },
                                "rowCount": {
                                    "type": "integer"
                                },
                                "columnCount": {
                                    "type": "integer"
                                }
                            },
                            "required": [
                                "sheetId",
                                "title",
                                "index"
                            ]
                        }
                    }
                },
                "required": [
                    "id",
                    "title",
                    "url",
                    "sheets"
                ]
            },
            "errors": [
                {
                    "when": "{{response.status == 404}}",
                    "error": "notFound",
                    "message": "That spreadsheet does not exist, or is not shared with this account",
                    "field": "spreadsheetId"
                }
            ],
            "output": "{{{ id: response.body.spreadsheetId, title: response.body.properties.title, url: response.body.spreadsheetUrl, locale: response.body.properties.locale, timeZone: response.body.properties.timeZone, sheets: map(default(response.body.sheets, []), s => compactObject({ sheetId: s.properties.sheetId, title: s.properties.title, index: s.properties.index, rowCount: s.properties.gridProperties.rowCount, columnCount: s.properties.gridProperties.columnCount })) } | compactObject}}",
            "request": {
                "query": {
                    "fields": "spreadsheetId,spreadsheetUrl,properties(title,locale,timeZone),sheets.properties(sheetId,title,index,gridProperties(rowCount,columnCount))"
                },
                "url": "/spreadsheets/{{urlEncode(inputs.spreadsheetId)}}"
            }
        },
        {
            "id": "create-spreadsheet",
            "kind": "action",
            "label": "Create spreadsheet",
            "group": "Spreadsheets",
            "inputs": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "title": "Title"
                    },
                    "sheets": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "title": "Sheets",
                        "description": "Names of the tabs to start with. Default: one called Sheet1."
                    }
                },
                "required": [
                    "title"
                ]
            },
            "outputs": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string"
                    },
                    "sheets": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "id",
                    "title",
                    "url",
                    "sheets"
                ]
            },
            "output": {
                "id": "{{response.body.spreadsheetId}}",
                "title": "{{response.body.properties.title}}",
                "url": "{{response.body.spreadsheetUrl}}",
                "sheets": "{{map(default(response.body.sheets, []), s => s.properties.title)}}"
            },
            "request": {
                "method": "POST",
                "body": {
                    "properties": {
                        "title": "{{inputs.title}}"
                    },
                    "sheets": "{{inputs.sheets == undefined ? undefined : map(inputs.sheets, title => {properties: {title}})}}"
                },
                "url": "/spreadsheets"
            }
        },
        {
            "id": "add-sheet",
            "kind": "action",
            "label": "Add sheet",
            "group": "Spreadsheets",
            "inputs": {
                "type": "object",
                "properties": {
                    "spreadsheetId": {
                        "type": "string",
                        "title": "Spreadsheet",
                        "x-options": {
                            "operation": "list-spreadsheets",
                            "search": "query"
                        }
                    },
                    "title": {
                        "type": "string",
                        "title": "Sheet name"
                    }
                },
                "required": [
                    "spreadsheetId",
                    "title"
                ]
            },
            "outputs": {
                "type": "object",
                "properties": {
                    "sheetId": {
                        "type": "integer"
                    },
                    "title": {
                        "type": "string"
                    },
                    "index": {
                        "type": "integer"
                    }
                },
                "required": [
                    "sheetId",
                    "title",
                    "index"
                ]
            },
            "errors": [
                {
                    "when": "{{response.status == 404}}",
                    "error": "notFound",
                    "message": "That spreadsheet does not exist, or is not shared with this account",
                    "field": "spreadsheetId"
                },
                {
                    "when": "{{response.status == 400 && contains(default(response.body.error.message, ''), 'already exists')}}",
                    "error": "validation",
                    "message": "A sheet with that name already exists",
                    "field": "title"
                }
            ],
            "output": "{{first(response.body.replies).addSheet.properties | pick('sheetId', 'title', 'index')}}",
            "request": {
                "method": "POST",
                "body": {
                    "requests": [
                        {
                            "addSheet": {
                                "properties": {
                                    "title": "{{inputs.title}}"
                                }
                            }
                        }
                    ]
                },
                "url": "/spreadsheets/{{urlEncode(inputs.spreadsheetId)}}:batchUpdate"
            }
        },
        {
            "id": "get-values",
            "kind": "action",
            "label": "Get rows",
            "description": "The values in a sheet or range — as objects keyed by the header row, or as plain lists.",
            "group": "Values",
            "readOnly": true,
            "inputs": {
                "type": "object",
                "properties": {
                    "spreadsheetId": {
                        "type": "string",
                        "title": "Spreadsheet",
                        "x-options": {
                            "operation": "list-spreadsheets",
                            "search": "query"
                        }
                    },
                    "sheet": {
                        "type": "string",
                        "title": "Sheet",
                        "x-options": {
                            "operation": "list-sheets",
                            "inputs": {
                                "spreadsheetId": "{{inputs.spreadsheetId}}"
                            },
                            "dependsOn": [
                                "spreadsheetId"
                            ]
                        }
                    },
                    "range": {
                        "type": "string",
                        "title": "Range",
                        "description": "A1 notation within the sheet, e.g. A1:D50. Default: the whole sheet.",
                        "x-placeholder": "A1:D50"
                    },
                    "headerRow": {
                        "type": "boolean",
                        "title": "First row is a header",
                        "description": "Return the other rows as objects keyed by it.",
                        "default": true
                    },
                    "formatted": {
                        "type": "boolean",
                        "title": "Formatted values",
                        "description": "As shown in the sheet (“$1,000.00”) rather than raw (1000).",
                        "default": true,
                        "x-advanced": true
                    }
                },
                "required": [
                    "spreadsheetId",
                    "sheet"
                ]
            },
            "outputs": {
                "type": "object",
                "properties": {
                    "range": {
                        "type": "string"
                    },
                    "headers": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "rows": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "x-widget": "json"
                        }
                    }
                },
                "required": [
                    "range",
                    "rows"
                ]
            },
            "errors": [
                {
                    "when": "{{response.status == 404}}",
                    "error": "notFound",
                    "message": "That spreadsheet does not exist, or is not shared with this account",
                    "field": "spreadsheetId"
                },
                {
                    "when": "{{response.status == 400 && contains(default(response.body.error.message, ''), 'Unable to parse range')}}",
                    "error": "validation",
                    "message": "That sheet or range does not exist",
                    "field": "sheet"
                }
            ],
            "output": "{{inputs.headerRow == false ? {range: response.body.range, rows: default(response.body.values, [])} : { range: response.body.range, headers: default(first(default(response.body.values, [])), []), rows: map(slice(default(response.body.values, []), 1), r => recordOf(first(response.body.values), r)) }}}",
            "request": {
                "query": {
                    "valueRenderOption": "{{inputs.formatted == false ? 'UNFORMATTED_VALUE' : 'FORMATTED_VALUE'}}",
                    "majorDimension": "ROWS"
                },
                "url": "/spreadsheets/{{urlEncode(inputs.spreadsheetId)}}/values/{{urlEncode(a1(inputs.sheet, inputs.range))}}"
            }
        },
        {
            "id": "append-rows",
            "kind": "action",
            "label": "Append rows",
            "description": "Add rows below the last row of the table. Objects are matched to the header row; keys it lacks are ignored.",
            "group": "Values",
            "inputs": {
                "type": "object",
                "properties": {
                    "spreadsheetId": {
                        "type": "string",
                        "title": "Spreadsheet",
                        "x-options": {
                            "operation": "list-spreadsheets",
                            "search": "query"
                        }
                    },
                    "sheet": {
                        "type": "string",
                        "title": "Sheet",
                        "x-options": {
                            "operation": "list-sheets",
                            "inputs": {
                                "spreadsheetId": "{{inputs.spreadsheetId}}"
                            },
                            "dependsOn": [
                                "spreadsheetId"
                            ]
                        }
                    },
                    "rows": {
                        "type": "array",
                        "x-widget": "json",
                        "title": "Rows",
                        "description": "A list of rows. Each row is a list of cell values, or an object whose keys match the header row.",
                        "examples": [
                            [
                                [
                                    "Ada",
                                    "ada@example.com",
                                    36
                                ]
                            ],
                            [
                                {
                                    "Name": "Ada",
                                    "Email": "ada@example.com"
                                }
                            ]
                        ]
                    },
                    "valueInputOption": {
                        "type": "string",
                        "title": "Values are",
                        "default": "USER_ENTERED",
                        "x-advanced": true,
                        "oneOf": [
                            {
                                "const": "USER_ENTERED",
                                "title": "As if typed (formulas, numbers and dates are parsed)"
                            },
                            {
                                "const": "RAW",
                                "title": "Exactly as given"
                            }
                        ]
                    }
                },
                "required": [
                    "spreadsheetId",
                    "sheet",
                    "rows"
                ]
            },
            "outputs": {
                "type": "object",
                "properties": {
                    "spreadsheetId": {
                        "type": "string"
                    },
                    "updatedRange": {
                        "type": "string"
                    },
                    "updatedRows": {
                        "type": "integer"
                    },
                    "updatedCells": {
                        "type": "integer"
                    }
                },
                "required": [
                    "spreadsheetId",
                    "updatedRows",
                    "updatedCells"
                ]
            },
            "steps": [
                {
                    "name": "header",
                    "url": "/spreadsheets/{{urlEncode(inputs.spreadsheetId)}}/values/{{urlEncode(a1(inputs.sheet, \"1:1\"))}}",
                    "when": "{{some(inputs.rows, r => type(r) == 'object')}}",
                    "output": {
                        "headers": "{{default(first(default(response.body.values, [])), [])}}"
                    }
                }
            ],
            "errors": [
                {
                    "when": "{{response.status == 404}}",
                    "error": "notFound",
                    "message": "That spreadsheet does not exist, or is not shared with this account",
                    "field": "spreadsheetId"
                },
                {
                    "when": "{{response.status == 400 && contains(default(response.body.error.message, ''), 'Unable to parse range')}}",
                    "error": "validation",
                    "message": "That sheet or range does not exist",
                    "field": "sheet"
                }
            ],
            "output": {
                "spreadsheetId": "{{response.body.spreadsheetId}}",
                "updatedRange": "{{response.body.updates.updatedRange}}",
                "updatedRows": "{{default(response.body.updates.updatedRows, 0)}}",
                "updatedCells": "{{default(response.body.updates.updatedCells, 0)}}"
            },
            "request": {
                "method": "POST",
                "query": {
                    "valueInputOption": "{{default(inputs.valueInputOption, 'USER_ENTERED')}}",
                    "insertDataOption": "INSERT_ROWS"
                },
                "body": {
                    "majorDimension": "ROWS",
                    "values": "{{map(inputs.rows, r => rowOf(default(steps.header.headers, []), r))}}"
                },
                "url": "/spreadsheets/{{urlEncode(inputs.spreadsheetId)}}/values/{{urlEncode(a1(inputs.sheet, undefined))}}:append"
            }
        },
        {
            "id": "update-values",
            "kind": "action",
            "label": "Update cells",
            "description": "Write rows of values over a range, starting at its top-left cell.",
            "group": "Values",
            "inputs": {
                "type": "object",
                "properties": {
                    "spreadsheetId": {
                        "type": "string",
                        "title": "Spreadsheet",
                        "x-options": {
                            "operation": "list-spreadsheets",
                            "search": "query"
                        }
                    },
                    "sheet": {
                        "type": "string",
                        "title": "Sheet",
                        "x-options": {
                            "operation": "list-sheets",
                            "inputs": {
                                "spreadsheetId": "{{inputs.spreadsheetId}}"
                            },
                            "dependsOn": [
                                "spreadsheetId"
                            ]
                        }
                    },
                    "range": {
                        "type": "string",
                        "title": "Range",
                        "description": "Where to write, in A1 notation — e.g. B2, or A2:C10.",
                        "x-placeholder": "A2"
                    },
                    "rows": {
                        "type": "array",
                        "x-widget": "json",
                        "title": "Rows",
                        "description": "A list of rows, each a list of cell values.",
                        "examples": [
                            [
                                [
                                    "Ada",
                                    36
                                ]
                            ]
                        ]
                    },
                    "valueInputOption": {
                        "type": "string",
                        "title": "Values are",
                        "default": "USER_ENTERED",
                        "x-advanced": true,
                        "oneOf": [
                            {
                                "const": "USER_ENTERED",
                                "title": "As if typed (formulas, numbers and dates are parsed)"
                            },
                            {
                                "const": "RAW",
                                "title": "Exactly as given"
                            }
                        ]
                    }
                },
                "required": [
                    "spreadsheetId",
                    "sheet",
                    "range",
                    "rows"
                ]
            },
            "outputs": {
                "type": "object",
                "properties": {
                    "spreadsheetId": {
                        "type": "string"
                    },
                    "updatedRange": {
                        "type": "string"
                    },
                    "updatedRows": {
                        "type": "integer"
                    },
                    "updatedCells": {
                        "type": "integer"
                    }
                },
                "required": [
                    "spreadsheetId",
                    "updatedRows",
                    "updatedCells"
                ]
            },
            "errors": [
                {
                    "when": "{{response.status == 404}}",
                    "error": "notFound",
                    "message": "That spreadsheet does not exist, or is not shared with this account",
                    "field": "spreadsheetId"
                },
                {
                    "when": "{{response.status == 400 && contains(default(response.body.error.message, ''), 'Unable to parse range')}}",
                    "error": "validation",
                    "message": "That sheet or range does not exist",
                    "field": "range"
                }
            ],
            "output": {
                "spreadsheetId": "{{response.body.spreadsheetId}}",
                "updatedRange": "{{response.body.updatedRange}}",
                "updatedRows": "{{default(response.body.updatedRows, 0)}}",
                "updatedCells": "{{default(response.body.updatedCells, 0)}}"
            },
            "request": {
                "method": "PUT",
                "query": {
                    "valueInputOption": "{{default(inputs.valueInputOption, 'USER_ENTERED')}}"
                },
                "body": {
                    "majorDimension": "ROWS",
                    "values": "{{inputs.rows}}"
                },
                "url": "/spreadsheets/{{urlEncode(inputs.spreadsheetId)}}/values/{{urlEncode(a1(inputs.sheet, inputs.range))}}"
            }
        },
        {
            "id": "clear-values",
            "kind": "action",
            "label": "Clear cells",
            "description": "Empty the cells of a range (or the whole sheet), keeping their formatting.",
            "group": "Values",
            "destructive": true,
            "inputs": {
                "type": "object",
                "properties": {
                    "spreadsheetId": {
                        "type": "string",
                        "title": "Spreadsheet",
                        "x-options": {
                            "operation": "list-spreadsheets",
                            "search": "query"
                        }
                    },
                    "sheet": {
                        "type": "string",
                        "title": "Sheet",
                        "x-options": {
                            "operation": "list-sheets",
                            "inputs": {
                                "spreadsheetId": "{{inputs.spreadsheetId}}"
                            },
                            "dependsOn": [
                                "spreadsheetId"
                            ]
                        }
                    },
                    "range": {
                        "type": "string",
                        "title": "Range",
                        "description": "Default: the whole sheet.",
                        "x-placeholder": "A2:D"
                    }
                },
                "required": [
                    "spreadsheetId",
                    "sheet"
                ]
            },
            "outputs": {
                "type": "object",
                "properties": {
                    "spreadsheetId": {
                        "type": "string"
                    },
                    "clearedRange": {
                        "type": "string"
                    }
                },
                "required": [
                    "spreadsheetId",
                    "clearedRange"
                ]
            },
            "errors": [
                {
                    "when": "{{response.status == 404}}",
                    "error": "notFound",
                    "message": "That spreadsheet does not exist, or is not shared with this account",
                    "field": "spreadsheetId"
                },
                {
                    "when": "{{response.status == 400 && contains(default(response.body.error.message, ''), 'Unable to parse range')}}",
                    "error": "validation",
                    "message": "That sheet or range does not exist",
                    "field": "sheet"
                }
            ],
            "output": {
                "spreadsheetId": "{{response.body.spreadsheetId}}",
                "clearedRange": "{{response.body.clearedRange}}"
            },
            "request": {
                "method": "POST",
                "body": {},
                "url": "/spreadsheets/{{urlEncode(inputs.spreadsheetId)}}/values/{{urlEncode(a1(inputs.sheet, inputs.range))}}:clear"
            }
        },
        {
            "id": "new-row",
            "kind": "trigger",
            "label": "New row",
            "description": "Fires for each row added below the last one seen, with its values keyed by the header row.",
            "group": "Triggers",
            "readOnly": true,
            "inputs": {
                "type": "object",
                "properties": {
                    "spreadsheetId": {
                        "type": "string",
                        "title": "Spreadsheet",
                        "x-options": {
                            "operation": "list-spreadsheets",
                            "search": "query"
                        }
                    },
                    "sheet": {
                        "type": "string",
                        "title": "Sheet",
                        "x-options": {
                            "operation": "list-sheets",
                            "inputs": {
                                "spreadsheetId": "{{inputs.spreadsheetId}}"
                            },
                            "dependsOn": [
