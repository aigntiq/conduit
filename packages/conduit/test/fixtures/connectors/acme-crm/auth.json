{
    "methods": [
        {
            "id": "oauth",
            "type": "oauth2",
            "label": "Sign in with Acme",
            "authorizeUrl": "{{config.authUrl}}/oauth/authorize",
            "tokenUrl": "{{config.authUrl}}/oauth/token",
            "revokeUrl": "{{config.authUrl}}/oauth/revoke",
            "scopes": ["contacts:read", "contacts:write", "offline_access"],
            "authorizeParams": { "prompt": "consent" },
            "identity": {
                "request": { "url": "/me" },
                "id": "{{response.body.id}}",
                "name": "{{response.body.email}}",
                "data": { "region": "{{response.body.region}}" }
            },
            "test": { "url": "/me" }
        },
        {
            "id": "key",
            "type": "apiKey",
            "label": "API key",
            "name": "Authorization",
            "prefix": "Token ",
            "inputs": {
                "type": "object",
                "properties": {
                    "apiKey": { "type": "string", "title": "API key", "format": "password", "x-secret": true, "minLength": 8 },
                    "region": { "type": "string", "title": "Region", "enum": ["eu", "us"], "default": "eu" }
                },
                "required": ["apiKey"]
            },
            "identity": {
                "request": { "url": "/me" },
                "id": "{{response.body.id}}",
                "name": "{{response.body.email}}",
                "data": { "region": "{{inputs.region}}" }
            },
            "test": { "url": "/me" }
        }
    ]
}
